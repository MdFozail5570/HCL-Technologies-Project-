import numpy as np
import pandas as pd

# ==========================================
# 1. Load and Inspect the Dataset
# ==========================================
def load_and_inspect_data(filepath):
    """Loads the CSV dataset and prints basic structural summaries."""
    df = pd.read_csv(filepath)
    print("--- 1. DATASET OVERVIEW ---")
    print(f"Shape (Rows, Columns): {df.shape}")
    print("\nColumn Data Types & Non-Null Counts:")
    print(df.info())
    print("\nFirst 5 Records:")
    print(df.head())
    return df

# Load dataset (Update path if placed in a /data/ subfolder)
df = load_and_inspect_data("02_student_performance.csv")

# ==========================================
# 2. Missing Values & Duplicate Student_IDs
# ==========================================
print("\n--- 2. DATA QUALITY CHECKS ---")
missing_counts = df.isnull().sum()
print("Missing Values per Column:\n", missing_counts)

duplicate_ids = df["Student_ID"].duplicated().sum()
print(f"\nDuplicate Student_ID Count: {duplicate_ids}")

# Handle missing Attendance_Percent values:
# Strategy: Impute missing attendance using department-wise median attendance. 
# Median is chosen over mean so extreme attendance outliers do not skew imputed values.
df["Attendance_Percent"] = df["Attendance_Percent"].fillna(
    df.groupby("Department")["Attendance_Percent"].transform("median")
)
print(f"Missing Attendance_Percent after department-median imputation: {df['Attendance_Percent'].isnull().sum()}")

# ==========================================
# 3. Validate Score Columns (0–100 Range)
# ==========================================
print("\n--- 3. SCORE VALIDATION (0 TO 100) ---")
score_cols = ["Python_Marks", "Maths_Marks", "Physics_Marks"]
for col in score_cols:
    out_of_bounds = df[(df[col] < 0) | (df[col] > 100)]
    print(f"{col} values outside: {len(out_of_bounds)}")

# ==========================================
# 4. Calculate Total & Average Marks + Grade Column
# ==========================================
print("\n--- 4. TOTAL, AVERAGE MARKS & GRADE DISTRIBUTION ---")
df["Calculated_Total"] = df[score_cols].sum(axis=1)
df["Average_Marks"] = (df["Calculated_Total"] / len(score_cols)).round(2)

# Verify against supplied Total_Marks column
mismatches = (df["Calculated_Total"] != df["Total_Marks"]).sum()
print(f"Total_Marks verification mismatches: {mismatches}")

# Create Grade column using clearly defined score ranges:
# <40: F | 40-54.99: D | 55-69.99: C | 70-84.99: B | 85-100: A
grade_bins = [-np.inf, 39.99, 54.99, 69.99, 84.99, 100]
grade_labels = ["F", "D", "C", "B", "A"]
df["Grade"] = pd.cut(df["Average_Marks"], bins=grade_bins, labels=grade_labels)

print("\nGrade Distribution:")
print(df["Grade"].value_counts().sort_index())

# ==========================================
# 5. Department-Wise Average Marks
# ==========================================
print("\n--- 5. DEPARTMENT-WISE ACADEMIC SUMMARY ---")
dept_summary = df.groupby("Department").agg(
    Student_Count=("Student_ID", "count"),
    Avg_Attendance=("Attendance_Percent", "mean"),
    Avg_Study_Hours=("Study_Hours_Per_Day", "mean"),
    Avg_Python=("Python_Marks", "mean"),
    Avg_Maths=("Maths_Marks", "mean"),
    Avg_Physics=("Physics_Marks", "mean"),
    Overall_Avg_Marks=("Average_Marks", "mean")
).round(2).sort_values(by="Overall_Avg_Marks", ascending=False)
print(dept_summary)

# ==========================================
# 6. Top 10 Students & At-Risk Students (<40%)
# ==========================================
print("\n--- 6. TOP 10 STUDENTS BY AVERAGE MARKS ---")
top_10_students = df.sort_values(by="Average_Marks", ascending=False).head(10)
print(top_10_students[["Student_ID", "Department", "Attendance_Percent", "Study_Hours_Per_Day", "Average_Marks", "Grade"]])

print("\n--- AT-RISK STUDENTS (< 40% AVERAGE MARKS) ---")
at_risk_students = df[df["Average_Marks"] < 40.0]
print(f"Students below 40% overall average: {len(at_risk_students)}")

# Also check students flagged as 'Fail' in the Result column (subject-level failure)
subject_fail_students = df[df["Result"] == "Fail"]
print(f"Students marked 'Fail' in Result column (subject-level fail <35): {len(subject_fail_students)}")

# ==========================================
# 7. Attendance Bands & Study Hours Analysis
# ==========================================
print("\n--- 7. PERFORMANCE BY ATTENDANCE BANDS ---")
att_bins = [0, 60, 75, 85, 100]
att_labels = ["Low (<=60%)", "Moderate (60-75%)", "Good (75-85%)", "High (>85%)"]
df["Attendance_Band"] = pd.cut(df["Attendance_Percent"], bins=att_bins, labels=att_labels)

attendance_analysis = df.groupby("Attendance_Band", observed=False).agg(
    Student_Count=("Student_ID", "count"),
    Mean_Average_Marks=("Average_Marks", "mean"),
    Median_Average_Marks=("Average_Marks", "median")
).round(2)
print(attendance_analysis)

print("\n--- STUDY HOURS VS. AVERAGE MARKS ---")
study_corr = df["Study_Hours_Per_Day"].corr(df["Average_Marks"])
print(f"Pearson Correlation (Study Hours vs. Average Marks): {study_corr:.4f}")

# Compare study hour brackets using np.where()
df["Study_Habit"] = np.where(df["Study_Hours_Per_Day"] >= 3.5, "High Study (>=3.5 hrs)", "Regular Study (<3.5 hrs)")
print(df.groupby("Study_Habit")["Average_Marks"].agg(["count", "mean", "median"]).round(2))

# ==========================================
# 8. Internet Access Comparison
# ==========================================
print("\n--- 8. PERFORMANCE BY INTERNET ACCESS ---")
internet_summary = df.groupby("Internet_Access").agg(
    Student_Count=("Student_ID", "count"),
    Avg_Python_Marks=("Python_Marks", "mean"),
    Avg_Overall_Marks=("Average_Marks", "mean"),
    Avg_Assignments=("Assignments_Submitted", "mean")
).round(2)
print(internet_summary)

# ==========================================
# 9. NumPy Statistics & IQR Outliers (Python_Marks)
# ==========================================
print("\n--- 9. NUMPY STATISTICS & OUTLIERS (PYTHON_MARKS) ---")
python_arr = df["Python_Marks"].to_numpy()

py_median = np.median(python_arr)
py_std = np.std(python_arr)
py_q1 = np.percentile(python_arr, 25)
py_q3 = np.percentile(python_arr, 75)
py_iqr = py_q3 - py_q1

lower_bound = py_q1 - 1.5 * py_iqr
upper_bound = py_q3 + 1.5 * py_iqr

print(f"Median Python Marks: {py_median:.2f}")
print(f"Standard Deviation:  {py_std:.2f}")
print(f"Q1 (25th Percentile): {py_q1:.2f} | Q3 (75th Percentile): {py_q3:.2f} | IQR: {py_iqr:.2f}")
print(f"IQR Bounds: [{lower_bound:.2f}, {upper_bound:.2f}]")

py_outliers = df[(df["Python_Marks"] < lower_bound) | (df["Python_Marks"] > upper_bound)]
print(f"Potential Python_Marks Outliers Detected: {len(py_outliers)}")

# Save cleaned and enriched dataset for repository deliverables
df.to_csv("02_student_performance_cleaned.csv", index=False)
print("\nCleaned dataset saved to '02_student_performance_cleaned.csv'.")